# Logs
# Anchored: a bare `logs` matches any directory of that name at any depth, which silently
# excluded next/src/app/features/jobs/logs -- a whole feature that was never committed.
/logs/
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules
jspm_packages
typings

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Generated files
dist
# Angular 22 rewrite (next/) — its own node_modules and build output
next/node_modules/
next/dist/
next/.angular/
